# =============================================================================
# Portail Client - Environment Configuration Template
# =============================================================================
# Copy this file to '.env' before starting the application:
#   cp .env.example .env
#
# IMPORTANT: Generate secure random strings for production passwords & secrets:
#   openssl rand -hex 32
# =============================================================================

# --- PostgreSQL Database ---
POSTGRES_USER=portail_user
POSTGRES_PASSWORD=change_this_to_a_secure_password_in_production
POSTGRES_DB=portail_client
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Application Security ---
# Secret key for JWT signing / session hashing (generate with: openssl rand -hex 32)
SECRET_KEY=change_this_to_a_random_32_character_hex_string

# Environment Mode (production | staging | development)
ENVIRONMENT=production

# --- Amorçage du compte prestataire (administrateur) ---
# Au démarrage, l'application garantit l'existence d'un compte `role=admin`.
# Si l'email correspond à un compte existant -> il est promu administrateur ;
# sinon, si le mot de passe est aussi fourni -> le compte est créé.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=

# Origines autorisées pour le CORS, séparées par des virgules ; en production
# mettre https://<domaine> ; ne jamais mettre `*`
CORS_ORIGINS=http://localhost:5173

# Durée de validité du jeton JWT en minutes
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Version applicative exposée par /health et /api/health
APP_VERSION=1.0.0

# --- Public Domain & Reverse Proxy ---
# For local testing, use 'localhost'.
# For public production with DuckDNS, use e.g. 'mon-portail.duckdns.org'
# For Tailscale Funnel, use your Tailscale node domain: e.g. 'my-node.tailnet.ts.net'
DOMAIN_NAME=localhost

# Optional: Email address used by Let's Encrypt for TLS expiry notifications
CADDY_EMAIL=admin@example.com

# --- Storage & Uploads ---
# Absolute path inside the backend container where uploads are stored
UPLOAD_DIR=/uploads

# Taille maximale d'un document envoyé, en octets — 10 Mio
MAX_UPLOAD_BYTES=10485760

# --- Backup Configuration ---
# Retention period in days for pg_dump and uploads backups (default: 7 days)
BACKUP_RETENTION_DAYS=7

# Clé publique age (age1...) utilisée pour chiffrer les sauvegardes ;
# générée par ./scripts/install.sh
BACKUP_AGE_RECIPIENT=

# Chemin de l'identité privée age utilisée pour déchiffrer lors d'une
# restauration ; ne jamais commiter
BACKUP_AGE_IDENTITY=/opt/portail_client/secrets/backup_age.key
