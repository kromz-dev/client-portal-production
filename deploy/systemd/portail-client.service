# =============================================================================
# portail-client.service
# -----------------------------------------------------------------------------
# Rend la reprise apres redemarrage de l'hote deterministe : au boot, systemd
# lance « docker compose up -d » dans /opt/portail_client. Complementaire du
# « restart: unless-stopped » des conteneurs (qui ne couvre pas le cas d'un
# « compose down » manuel suivi d'un reboot).
#
# Installation : ./scripts/install-timers.sh  (copie ce fichier dans
# /etc/systemd/system/ puis « systemctl enable portail-client.service »).
# Le chemin /opt/portail_client est code en dur : adaptez-le si le projet est
# deploye ailleurs.
# =============================================================================
[Unit]
Description=Portail Client - pile Docker Compose (FastAPI + PostgreSQL + Caddy)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/portail_client
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down

[Install]
WantedBy=multi-user.target
